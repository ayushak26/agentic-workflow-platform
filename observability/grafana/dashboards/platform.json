{
    "title": "AWP Platform",
    "uid": "awp-platform",
    "schemaVersion": 39,
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "title": "Node latency p95 (s) by type",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(awp_node_execution_seconds_bucket[5m])) by (le, node_type))",
            "legendFormat": "{{node_type}}"
          }
        ]
      },
      {
        "title": "Node error rate (per s) by type",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(awp_node_runs_total{status=\"error\"}[5m])) by (node_type)",
            "legendFormat": "{{node_type}}"
          }
        ]
      },
      {
        "title": "Workflow runs (per 5m) by outcome",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(increase(awp_workflow_runs_total[5m])) by (status)",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "title": "LLM tokens (per 5m) by model & direction",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum(increase(awp_llm_tokens_total[5m])) by (model, direction)",
            "legendFormat": "{{model}} {{direction}}"
          }
        ]
      }
    ]
  }