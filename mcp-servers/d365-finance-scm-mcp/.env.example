# Finance & Operations environment root URL (no /data suffix).
FNO_BASE_URL=https://YOUR-ENVIRONMENT.operations.dynamics.com

# Microsoft Entra app registration, mapped to an F&O service user.
FNO_TENANT_ID=YOUR-TENANT-ID
FNO_CLIENT_ID=YOUR-CLIENT-ID
FNO_CLIENT_SECRET=YOUR-CLIENT-SECRET

# Writes/deletes are fail-closed: enabling either requires a non-empty allowlist below.
FNO_ALLOW_WRITES=false
FNO_ALLOW_DELETES=false

# Comma-separated entity set names. Empty = every entity set is permitted for that operation.
FNO_READ_ENTITY_ALLOWLIST=
FNO_WRITE_ENTITY_ALLOWLIST=
FNO_DELETE_ENTITY_ALLOWLIST=

# JSON object mapping a friendly alias -> confirmed entity set name.
FNO_ENTITY_ALIASES_JSON={}

# Optional tuning (defaults shown).
FNO_TIMEOUT_MS=20000
FNO_MAX_RETRIES=3
FNO_MAX_PAGE_SIZE=100
FNO_MAX_PAGES=10
