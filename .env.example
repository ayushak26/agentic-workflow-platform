# App
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ENVIRONMENT=development
API_DOCS_ENABLED=true
METRICS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# MongoDB
MONGO_ROOT_USERNAME=replace-with-local-mongo-user
MONGO_ROOT_PASSWORD=replace-with-local-mongo-password
MONGO_URI=mongodb://replace-with-local-mongo-user:replace-with-local-mongo-password@mongo:27017/?authSource=admin
MONGO_DB=eurskem_ai

# Weaviate
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY_USER=eurskem-app
WEAVIATE_API_KEY=replace-with-local-weaviate-api-key

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-local-minio-user
MINIO_SECRET_KEY=replace-with-local-minio-password
MINIO_BUCKET=eurskem-ai-docs

# Redis
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@redis:6379/0

# Grafana (local monitoring profile)
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# Runtime readiness. Enabled research services are added automatically.
HEALTH_PROBE_TIMEOUT_SECONDS=2
READINESS_REQUIRED_SERVICES=mongo,weaviate,minio,redis,checkpointer,mcp:eurskem

# Academic paper discovery. The API image contains paper-search-mcp 0.1.4.
PAPER_SEARCH_MCP_ENABLED=true
PAPER_SEARCH_MCP_PATH=
PAPER_SEARCH_MCP_COMMAND=python
PAPER_SEARCH_MCP_MODULE=paper_search_mcp.server
MCP_STARTUP_TIMEOUT_SECONDS=30
MCP_TOOL_TIMEOUT_SECONDS=90
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=

# Curated K-Dense Scientific Agent Skills. Expand the allowlist only after
# reviewing each SKILL.md and its individual license. This is the approved
# proposal-oriented allowlist used by the Horizon Part B pipeline; keep it in
# sync with docs/scientific_deep_research_pipeline.md.
SCIENTIFIC_SKILLS_ENABLED=true
SCIENTIFIC_SKILLS_PATH=/opt/scientific-agent-skills/skills
SCIENTIFIC_SKILLS_ALLOWLIST=literature-review,research-lookup,citation-management,research-grants,scientific-writing,scientific-critical-thinking,scientific-brainstorming,peer-review,database-lookup,markitdown,geomaster,geopandas,pymoo,networkx,hypothesis-generation,statistical-analysis
SCIENTIFIC_SKILLS_MAX_PROMPT_CHARS=30000

# database-lookup skill credentials (scientific-agent-skills/skills/database-lookup).
# Most of the 78 databases the skill covers need no credential at all. Only set
# a variable here if the corresponding database is actually selected for a run
# -- leave the rest blank. See SKILL.md's "API Keys and Access Restrictions"
# section for which mode (required/optional/licensed/none) each database uses.
#
# Required -- the database will not work at all without these:
FRED_API_KEY=
BEA_API_KEY=
NOAA_API_KEY=
OPENWEATHERMAP_API_KEY=
MP_API_KEY=
DATACOMMONS_API_KEY=
OMIM_API_KEY=
BIOGRID_API_KEY=
ALPHAVANTAGE_API_KEY=
CENSUS_API_KEY=
PATENTSVIEW_API_KEY=
USPTO_API_KEY=
CLUE_API_KEY=
ADDGENE_API_KEY=
DISGENET_API_KEY=
#
# Optional -- anonymous access works; a key only raises the rate limit:
NCBI_API_KEY=
BLS_API_KEY=
OPENFDA_API_KEY=
NASA_API_KEY=

# Bounded Deep Research: a chat_with_tools loop over the generic LLM gateway
# plus the web_search service -- no dedicated provider endpoint.
DEEP_RESEARCH_ENABLED=true

# Authenticated Server-Sent Events live feed.
SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_EVENTS_PER_RUN=1000
SSE_REPLAY_RUN_LIMIT=1000

# LLM
# Keep blank for ordinary CI. Configure only in a local secret store or the
# protected GitHub environment used by the manual live-LLM workflow.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search (WebSearchAgent, app/tools/web_io.py). Tavily is the primary/
# default provider - a free-tier key is enough to start. OPENAI_API_KEY above
# doubles as the fallback used only when Tavily's quota is exhausted.
TAVILY_API_KEY=

# Auth dev bypass (local only)
DEV_BYPASS_ENABLED=true
DEV_BYPASS_USERNAME=ayush
DEV_BYPASS_PASSWORD=dev123
