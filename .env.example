# App
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-unique-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=600
ENVIRONMENT=development
API_DOCS_ENABLED=true
METRICS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# MongoDB
MONGO_ROOT_USERNAME=replace-with-local-mongo-user
MONGO_ROOT_PASSWORD=replace-with-local-mongo-password
MONGO_URI=mongodb://replace-with-local-mongo-user:replace-with-local-mongo-password@mongo:27017/?authSource=admin
MONGO_DB=eurskem_ai

# Weaviate
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY_USER=eurskem-app
WEAVIATE_API_KEY=replace-with-local-weaviate-api-key

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-local-minio-user
MINIO_SECRET_KEY=replace-with-local-minio-password
MINIO_BUCKET=eurskem-ai-docs

# Redis
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_URL=redis://:replace-with-local-redis-password@redis:6379/0

# Grafana (local monitoring profile)
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# Runtime readiness. Enabled research services are added automatically.
HEALTH_PROBE_TIMEOUT_SECONDS=2
READINESS_REQUIRED_SERVICES=mongo,weaviate,minio,redis,checkpointer,mcp:eurskem
# End-to-end deadline for each Knowledge retrieval attempt. Individual
# Weaviate/network calls remain bounded by EXTERNAL_REQUEST_TIMEOUT_SECONDS.
KNOWLEDGE_RETRIEVAL_TIMEOUT_SECONDS=240

# Dynamics 365 Finance & Supply Chain (F&O OData), exposed through
# mcp-servers/d365-finance-scm-mcp. Distinct from the Dataverse CRM connector
# (DYNAMICS_* above, mock by default) — this one always calls a real F&O
# tenant, so it stays disabled until you configure a tenant and build the
# server with `npm run build` inside mcp-servers/d365-finance-scm-mcp.
FNO_MCP_ENABLED=false
FNO_BASE_URL=
FNO_TENANT_ID=
FNO_CLIENT_ID=
FNO_CLIENT_SECRET=
FNO_ALLOW_WRITES=false
FNO_ALLOW_DELETES=false
FNO_READ_ENTITY_ALLOWLIST=
FNO_WRITE_ENTITY_ALLOWLIST=
FNO_DELETE_ENTITY_ALLOWLIST=
FNO_ENTITY_ALIASES_JSON=

# Academic paper discovery. The API image contains paper-search-mcp 0.1.4.
PAPER_SEARCH_MCP_ENABLED=true
PAPER_SEARCH_MCP_PATH=
PAPER_SEARCH_MCP_COMMAND=python
PAPER_SEARCH_MCP_MODULE=paper_search_mcp.server
MCP_STARTUP_TIMEOUT_SECONDS=30
MCP_TOOL_TIMEOUT_SECONDS=90
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
PAPER_SEARCH_MCP_CORE_API_KEY=
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=

# Curated K-Dense Scientific Agent Skills. Expand the allowlist only after
# reviewing each SKILL.md and its individual license. This is the approved
# proposal-oriented allowlist used by the Horizon Part B pipeline; keep it in
# sync with docs/scientific_deep_research_pipeline.md.
SCIENTIFIC_SKILLS_ENABLED=true
SCIENTIFIC_SKILLS_PATH=/opt/scientific-agent-skills/skills
SCIENTIFIC_SKILLS_ALLOWLIST=literature-review,research-lookup,citation-management,research-grants,scientific-writing,scientific-critical-thinking,scientific-brainstorming,peer-review,database-lookup,markitdown,geomaster,geopandas,pymoo,networkx,hypothesis-generation,statistical-analysis
SCIENTIFIC_SKILLS_MAX_PROMPT_CHARS=30000

# database-lookup skill credentials (scientific-agent-skills/skills/database-lookup).
# Most of the 78 databases the skill covers need no credential at all. Only set
# a variable here if the corresponding database is actually selected for a run
# -- leave the rest blank. See SKILL.md's "API Keys and Access Restrictions"
# section for which mode (required/optional/licensed/none) each database uses.
#
# Required -- the database will not work at all without these:
FRED_API_KEY=
BEA_API_KEY=
NOAA_API_KEY=
OPENWEATHERMAP_API_KEY=
MP_API_KEY=
DATACOMMONS_API_KEY=
OMIM_API_KEY=
BIOGRID_API_KEY=
ALPHAVANTAGE_API_KEY=
CENSUS_API_KEY=
PATENTSVIEW_API_KEY=
USPTO_API_KEY=
CLUE_API_KEY=
ADDGENE_API_KEY=
DISGENET_API_KEY=
#
# Optional -- anonymous access works; a key only raises the rate limit:
NCBI_API_KEY=
BLS_API_KEY=
OPENFDA_API_KEY=
NASA_API_KEY=

# Bounded Deep Research: a chat_with_tools loop over the generic LLM gateway
# plus the web_search service -- no dedicated provider endpoint.
DEEP_RESEARCH_ENABLED=true

# Authenticated Server-Sent Events live feed.
SSE_HEARTBEAT_SECONDS=15
SSE_REPLAY_EVENTS_PER_RUN=1000
SSE_REPLAY_RUN_LIMIT=1000
# How long a run's Redis replay stream outlives its last event, so a client
# that reconnects can still resume from its Last-Event-ID.
SSE_REPLAY_TTL_SECONDS=86400

# TTL of the Redis leases that make cross-worker ownership exclusive: the
# stale-run cleanup leader, and BackgroundRunManager's per-run launch lease.
# Both renew while held, so this only bounds how long a dead worker's claim
# blocks another worker from taking over.
DISTRIBUTED_LEASE_SECONDS=120

# LLM
# Keep blank for ordinary CI. Configure only in a local secret store or the
# protected GitHub environment used by the manual live-LLM workflow.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web search (WebSearchAgent, app/tools/web_io.py). Tavily is the primary/
# default provider - a free-tier key is enough to start. OPENAI_API_KEY above
# doubles as the fallback used only when Tavily's quota is exhausted.
TAVILY_API_KEY=

# Auth dev bypass (local only)
DEV_BYPASS_ENABLED=true
DEV_BYPASS_USERNAME=ayush
DEV_BYPASS_PASSWORD=dev123

# Confidential entity protection / pre-LLM pseudonymisation (Phase 1).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must NOT equal SECRET_KEY -- a leaked JWT signing secret must not also
# decrypt every protected entity ever tokenized. Required (checked lazily,
# on first real use) whenever ENTITY_PROTECTION_DEFAULT_MODE != public --
# the default is "pseudonymised", so this is required in any real deployment.
ENTITY_VAULT_MASTER_KEY=replace-with-a-unique-random-secret
ENTITY_PROTECTION_DEFAULT_MODE=pseudonymised
ENTITY_MAPPING_TTL_SECONDS=2592000

# Email OAuth (Outlook via Microsoft Graph, Gmail) -- app/api/email_oauth.py
# lets someone connect a real mailbox through the Builder. Requires the
# deployment owner's own Azure AD app registration and/or Google Cloud OAuth
# client (client id/secret below come from that registration, not from here).
# EMAIL_TOKEN_VAULT_MASTER_KEY encrypts the stored access/refresh tokens --
# generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (checked lazily, on first connect) whenever either provider is
# used; must be at least 32 bytes and not a placeholder, or the callback
# fails with a 500 after the provider's consent screen already succeeded.
EMAIL_TOKEN_VAULT_MASTER_KEY=replace-with-a-unique-random-secret
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Integration OAuth (Google Drive, OneDrive) -- app/api/integration_oauth.py
# lets someone connect cloud storage through the Builder. Reuses the SAME
# Microsoft/Google OAuth app registrations above (Drive/OneDrive are
# requested with different scopes than the email integration's) -- the
# deployment owner must add drive.readonly / Files.Read.All scopes and the
# redirect URIs /api/builder/integrations/oauth/callback/{google_drive,onedrive}
# to those same app registrations.
# INTEGRATION_TOKEN_VAULT_MASTER_KEY encrypts the stored access/refresh
# tokens -- generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be a distinct value from EMAIL_TOKEN_VAULT_MASTER_KEY/
# ENTITY_VAULT_MASTER_KEY/SECRET_KEY, at least 32 bytes, and not a placeholder.
INTEGRATION_TOKEN_VAULT_MASTER_KEY=replace-with-a-unique-random-secret

# ---------------------------------------------------------------------------
# Knowledge Studio: embeddings
# ---------------------------------------------------------------------------
# Embeddings use any OpenAI-compatible /v1/embeddings server. Leave
# EMBEDDING_BASE_URL blank to call OpenAI directly with OPENAI_API_KEY.
#
# OpenRouter serves /v1/embeddings and is the configuration used here:
# openai/text-embedding-3-small returns 1536 dims, byte-for-byte the same
# model as calling OpenAI directly, so switching does not invalidate vectors.
# Moonshot/Kimi does NOT open its embeddings endpoint ("The API you are
# accessing is not open"), so Kimi is generation/vision only.
# Self-hosted alternatives that work unchanged: text-embeddings-inference,
# Infinity, vLLM, LM Studio, Ollama.
#
# Changing to a DIFFERENT model or dimension count invalidates existing
# vectors: build a new Index Version and activate it, rather than editing one
# in place.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=${OPENROUTER_API_KEY}
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Knowledge Studio: vision-augmented PDF parsing
# ---------------------------------------------------------------------------
# Parser Profiles with strategy "vision_augmented" render PDF pages that carry
# figures, charts or image-only tables and transcribe them with a vision
# model, so visual content becomes searchable. "ocr_fallback" uses the same
# provider when a PDF has no text layer at all.
#   openrouter -> uses OPENROUTER_API_KEY with any vision-capable model.
#   kimi       -> uses LOCAL_KIMI_API_KEY / LOCAL_KIMI_BASE_URL (kimi-k3).
# If OpenRouter returns 404 "No endpoints available matching your guardrail
# restrictions and data policy", the account's privacy settings admit no
# provider -- fix at https://openrouter.ai/settings/privacy. That is a routing
# policy, not an authentication problem: the API key still validates.
INGESTION_VISION_PROVIDER=openrouter
INGESTION_VISION_MODEL=google/gemini-2.5-flash
INGESTION_VISION_MAX_PAGES=20
INGESTION_VISION_SCALE=2.0
INGESTION_VISION_CONCURRENCY=3
INGESTION_VISION_MAX_OUTPUT_TOKENS=4096
