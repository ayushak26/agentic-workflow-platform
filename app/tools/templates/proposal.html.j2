<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ proposal_title }}</title>
</head>
<body class="template-{{ template }}">
  <header class="cover">
    <h1>{{ proposal_title }}</h1>
    <p class="client">Prepared for <strong>{{ client_name }}</strong></p>
  </header>

  {% for section_name, section_text in sections.items() %}
  <section class="proposal-section">
    <h2>{{ section_name }}</h2>
    <div class="content">
      {{ section_text | replace('\n\n', '</p><p>') | replace('\n', '<br>') | safe }}
    </div>
  </section>
  {% endfor %}

  <footer>
    <p>Confidential — {{ client_name }}</p>
  </footer>
</body>
</html>